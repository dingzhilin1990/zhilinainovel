# ===========================================
# zhilinainovel 环境变量配置
# 复制此文件为 .env 并填入你的值
# ===========================================

# MiniMax API Key（必需）
OPENAI_API_KEY=your-minimax-api-key-here

# MiniMax API 地址（默认）
OPENAI_BASE_URL=https://api.minimax.chat/v1

# 模型选择
# MiniMax-M2.5      - 快速对话（默认）
# MiniMax-Text-01   - 长文本（200K上下文）
# kimi-code/kimi-for-codi - 代码任务
MODEL=MiniMax-M2.5

# 服务器端口（默认 8080）
PORT=8080
